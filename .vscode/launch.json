{
    // Windows only: "clr" is the C# extension's debugger for the .NET Framework, which runs on Windows alone.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Connect Four",
            "type": "clr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net48/ConnectFour.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        }
    ]
}
