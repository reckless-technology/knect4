{
    // Windows: the Debug build under Visual Studio's debugger (the C/C++ extension's cppvsdbg).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Knect 4",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/build/debug/src/app/Knect4.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        }
    ]
}
