<Project Sdk="Microsoft.NET.Sdk">

  <!-- Connect Four, a Windows Forms game: one executable for the .NET Framework 4.8 that every Windows 10 and 11
       carries, so it runs with nothing installed. The reference assemblies come as a package, so any machine with the
       .NET SDK builds it, with or without Visual Studio's targeting packs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ConnectFour</RootNamespace>
    <AssemblyName>ConnectFour</AssemblyName>
    <!-- Properties/AssemblyInfo.cs holds the assembly's attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
